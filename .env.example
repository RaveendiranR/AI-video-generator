# Optional Hugging Face token for open models such as Kokoro-82M.
# HF_TOKEN=hf_your_token_here
#
# Optional Groq-compatible script generation.
# GROQ_API_KEY=your_key_here
#
# Pollinations image access. The current endpoint needs a key; without one the
# generator tries a legacy public endpoint that is being shut down (often HTTP 500).
# POLLINATIONS_API_KEY=your_key_here   # free key from https://enter.pollinations.ai (AI pictures now need it)
#
# Optional full-motion image-to-video generation through Runway Gen-4.5.
# RUNWAYML_API_SECRET=your_key_here
# Optional: Claude story-level director for Creator Pro
ANTHROPIC_API_KEY=
